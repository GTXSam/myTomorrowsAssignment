image:
    repository: 195275637740.dkr.ecr.eu-central-1.amazonaws.com/mytomorrows
    tag: latest
    pullPolicy: IfNotPresent
#Port Flask runs on and Container is exposed on
global:
    myTomAppPort: 8081
    replicas: 2
ingress:
    enabled: false
service:
    type: ClusterIP
hpa:
    enabled: false
    minReplicas: 1
    maxReplicas: 1
    targetCPUUtilizationPercentage: 80
    targetMemoryUtilizationPercentage: 80
pdb:
    enabled: false
    minAvailablePDB: 1
configMap:
